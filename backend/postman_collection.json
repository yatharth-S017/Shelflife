{
  "info": {
    "_postman_id": "shelflife-api-collection-2026",
    "name": "ShelfLife Library Management API",
    "description": "Postman Collection for ShelfLife Library Management REST API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Librarian Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"librarian@shelflife.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/auth/login", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "List Books",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:5000/api/books?page=1&limit=10&genre=Technology", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "books"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }, { "key": "genre", "value": "Technology" }] }
          }
        },
        {
          "name": "Add Book",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Pragmatic Programmer\",\n  \"author\": \"Andrew Hunt, David Thomas\",\n  \"ISBN\": \"9780201616224\",\n  \"genre\": \"Software Engineering\",\n  \"totalCopies\": 5,\n  \"availableCopies\": 5\n}"
            },
            "url": { "raw": "http://localhost:5000/api/books", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "books"] }
          }
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "Register Member",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah Connor\",\n  \"email\": \"sarah@example.com\",\n  \"membershipId\": \"MEM-1005\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/members", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "members"] }
          }
        },
        {
          "name": "Get Member Borrow History",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:5000/api/members/{{memberId}}/history", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "members", "{{memberId}}", "history"] }
          }
        }
      ]
    },
    {
      "name": "Borrow & Return",
      "item": [
        {
          "name": "Issue Book",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": \"{{bookId}}\",\n  \"memberId\": \"{{memberId}}\",\n  \"dueDate\": \"2026-10-25T00:00:00.000Z\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/borrow", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "borrow"] }
          }
        },
        {
          "name": "Return Book",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "http://localhost:5000/api/return/{{borrowId}}", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "return", "{{borrowId}}"] }
          }
        }
      ]
    }
  ]
}
